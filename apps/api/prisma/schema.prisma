generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  googleId     String        @unique
  email        String        @unique
  name         String?
  profileImage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  applications Application[]
  resumes      Resume[]
  jobPostingExtractions JobPostingExtraction[]

  @@map("users")
}

enum ApplicationStage {
  READY
  APPLIED
  INTERVIEW
  PASSED
  REJECTED
}

enum ResumeFileFormat {
  PDF
  DOCX
}

enum ResumeStatus {
  PENDING
  READY
}

enum ResumeType {
  PORTFOLIO
  RESUME
  OTHER
}

enum JobPostingPlatform {
  SARAMIN
  JOB_KOREA
  JOB_PLANET
  ZIGHANG
  ROCKET_PUNCH
  WORK24
  WANTED
  OTHER
}

enum JobPostingDeadlineType {
  DATE
  ROLLING
  UNTIL_FILLED
  UNKNOWN
}

model Application {
  id            String                 @id @default(uuid())
  userId        String
  stage         ApplicationStage       @default(READY)
  url           String
  platform      JobPostingPlatform     @default(OTHER)
  companyName   String?
  title         String?
  position      String?
  minYears      Int?
  maxYears      Int?
  location      String?
  deadline      DateTime?              @db.Date
  deadlineType  JobPostingDeadlineType @default(UNKNOWN)
  hiringProcess String[]               @default([])
  techStacks    String[]               @default([])
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@map("applications")
}

model Resume {
  id                 String           @id @default(uuid())
  userId             String
  name               String
  fileFormat         ResumeFileFormat
  resumeType         ResumeType
  contentType        String
  fileSize           Int
  s3Key              String           @unique
  status             ResumeStatus     @default(PENDING)
  uploadUrlExpiresAt DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("resumes")
}

model JobPostingExtraction {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("job_posting_extractions")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
