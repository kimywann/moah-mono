generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  googleId     String        @unique
  email        String        @unique
  name         String?
  profileImage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  applications Application[]

  @@map("users")
}

enum ApplicationStage {
  READY
  APPLIED
  INTERVIEW
  PASSED
  REJECTED
}

enum JobPostingPlatform {
  SARAMIN
  JOB_KOREA
  JOB_PLANET
  ZIGHANG
  ROCKET_PUNCH
  WORK24
  WANTED
  OTHER
}

model Application {
  id            String           @id @default(uuid())
  userId        String
  jobPostingId  String
  stage         ApplicationStage @default(READY)
  hiringProcess String[]         @default([])
  techStacks    String[]         @default([])
  createdAt     DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id])

  @@unique([userId, jobPostingId])
  @@map("applications")
}

model JobPosting {
  id          String             @id @default(uuid())
  url         String             @unique
  platform    JobPostingPlatform @default(OTHER)
  companyName String?
  title       String?
  position    String?
  career      String?
  location    String?
  deadline    DateTime?          @db.Date
  extractedAt DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  applications Application[]

  @@map("job_postings")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
