enum ApplicationStage {
  READY
  APPLIED
  INTERVIEW
  PASSED
  REJECTED
}

enum JobPostingPlatform {
  SARAMIN
  JOB_KOREA
  JOB_PLANET
  ZIGHANG
  ROCKET_PUNCH
  WORK24
  WANTED
  OTHER
}

enum JobPostingDeadlineType {
  DATE
  ROLLING
  UNTIL_FILLED
  UNKNOWN
}

model Application {
  id            String                 @id @default(uuid())
  userId        String
  stage         ApplicationStage       @default(READY)
  url           String?
  platform      JobPostingPlatform     @default(OTHER)
  companyName   String?
  title         String?
  position      String?
  minYears      Int?
  maxYears      Int?
  location      String?
  deadline      DateTime?              @db.Date
  deadlineType  JobPostingDeadlineType @default(UNKNOWN)
  hiringProcess String[]               @default([])
  techStacks    String[]               @default([])
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @default(now()) @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments ApplicationAttachment[]

  @@unique([userId, url])
  @@map("applications")
}

model ApplicationAttachment {
  applicationId String
  resumeId      String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resume      Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@id([applicationId, resumeId])
  @@index([resumeId])
  @@map("application_attachments")
}

model JobPostingExtraction {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("job_posting_extractions")
}
