enum ResumeFileFormat {
  PDF
  DOCX
}

enum ResumeStatus {
  PENDING
  READY
}

enum ResumeType {
  PORTFOLIO
  RESUME
  OTHER
}

model Resume {
  id                 String       @id @default(uuid())
  userId             String
  name               String
  fileFormat         ResumeFileFormat
  resumeType         ResumeType
  contentType        String
  fileSize           Int
  s3Key              String       @unique
  status             ResumeStatus @default(PENDING)
  uploadUrlExpiresAt DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("resumes")
}
